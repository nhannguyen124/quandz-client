{
  "schemaVersion": 1,
  "name": "Quandz Client",
  "id": "quandz-client",
  "version": "${version}",
  "description": "Based utility mod.",
  "authors": [
    "Quandz"
  ],
  "contact": {
    "homepage": "https://example.com",
    "issues": "https://example.com/issues",
    "sources": "https://example.com/source",
    "discord": "https://example.com/discord"
  },
  "license": "GPL-3.0",
  "icon": "assets/quandz-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.quandz.client.QuandzClient"
    ],
    "modmenu": [
      "me.quandz.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "quandz-client.mixins.json",
    "quandz-client-baritone.mixins.json",
    "quandz-client-indigo.mixins.json",
    "quandz-client-sodium.mixins.json",
    "quandz-client-lithium.mixins.json",
    "quandz-client-viafabricplus.mixins.json"
  ],
  "accessWidener": "quandz-client.accesswidener",
  "custom": {
    "quandz-client:build_number": "${build_number}",
    "quandz-client:color": "145,61,226",
    "quandz-client:commit": "${commit}",
    "modmenu": {
      "links": {
        "modmenu.discord": "https://example.com/discord"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.7.0",
    "morechathistory": "*"
  }
}
